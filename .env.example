# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ใช้ตอนรันบนเครื่องตัวเอง/VPS เท่านั้น)
# บน GitHub Actions ให้ใส่ใน Settings → Secrets and variables → Actions แทน
GEMINI_API_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=U...

# AI วาดภาพประกอบข่าว (ฟรีวันละราว 95 ภาพ) ดูวิธีขอใน README ขั้นที่ 3
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ภาพถ่ายสำรองเมื่อ AI วาดไม่ได้ (ฟรี) สมัครที่ pixabay.com แล้วดู key ที่ https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# ไม่บังคับ: ใช้ Pexels เป็นแหล่งภาพสำรองได้ ถ้ามี key อยู่แล้ว (Pexels หยุดออก key ใหม่)
PEXELS_API_KEY=

# ใช้เฉพาะเมื่อเปลี่ยน ai.provider เป็น claude ใน config.yaml
ANTHROPIC_API_KEY=
